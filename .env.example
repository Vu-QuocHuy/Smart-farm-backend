# Server
PORT=3000
BACKEND_PORT=8080
NODE_ENV=development

# Docker Compose local MongoDB
MONGODB_URI=mongodb://mongo:27017/smart_farm

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=30d

# MQTT
MQTT_BROKER=your-mqtt-broker.cloud.hivemq.com
MQTT_PORT=8883
MQTT_CLIENT_ID=smart_farm_backend
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_TOPIC_PREFIX=farm